---
interface Item {
  eyebrow?: string;
  title: string;
  text: string;
}

interface Props {
  items: Item[];
  columns?: 2 | 3;
}

const { items, columns = 3 } = Astro.props;
---

<div class:list={['case-grid', `columns-${columns}`]}>
  {items.map((item, index) => (
    <article>
      <span>{item.eyebrow ?? String(index + 1).padStart(2, '0')}</span>
      <h3>{item.title}</h3>
      <p>{item.text}</p>
    </article>
  ))}
</div>

<style>
  .case-grid {
    display: grid;
    gap: var(--space-3);
    width: min(calc(100vw - 2rem), var(--content-width));
    margin: var(--space-6) 0 var(--space-7) 50%;
    transform: translateX(-50%);
  }

  .columns-2 {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .columns-3 {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  article {
    min-width: 0;
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: rgba(255, 251, 243, 0.72);
    box-shadow: 0 12px 35px rgba(92, 67, 31, 0.055);
  }

  span {
    color: var(--color-accent-strong);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 750;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h3 {
    margin: var(--space-4) 0 var(--space-2);
    font-size: 1.24rem;
  }

  p {
    margin: 0;
    color: var(--color-text-soft);
    font-size: 0.88rem;
    line-height: 1.7;
  }

  @media (max-width: 760px) {
    .case-grid {
      width: calc(100vw - 1.25rem);
    }

    .columns-3 {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 560px) {
    .columns-2 {
      grid-template-columns: 1fr;
    }
  }
</style>
