---
interface Props {
  label: string;
  title: string;
  text: string;
}

const { label, title, text } = Astro.props;
---

<aside class="case-callout">
  <span>{label}</span>
  <h3>{title}</h3>
  <p>{text}</p>
</aside>

<style>
  .case-callout {
    position: relative;
    overflow: hidden;
    margin-block: var(--space-7);
    padding: clamp(1.5rem, 4vw, 2.6rem);
    border: 1px solid rgba(116, 82, 31, 0.24);
    border-radius: var(--radius-md);
    color: #4b381b;
    background:
      radial-gradient(circle at 88% 10%, rgba(255, 255, 255, 0.6), transparent 9rem),
      linear-gradient(145deg, #ead29a, #d9b76f);
    box-shadow: 0 16px 45px rgba(104, 72, 23, 0.12);
  }

  .case-callout::after {
    position: absolute;
    width: 8rem;
    height: 8rem;
    right: -2.5rem;
    bottom: -4.5rem;
    border: 1px solid rgba(75, 56, 27, 0.18);
    border-radius: 50%;
    content: '';
  }

  span {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 750;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  h3 {
    max-width: 26ch;
    margin: var(--space-4) 0 var(--space-3);
    font-size: clamp(1.6rem, 4vw, 2.35rem);
  }

  p {
    max-width: 55rem;
    margin: 0;
    font-size: 0.95rem;
  }
</style>
