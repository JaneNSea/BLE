---
import { navigation, site } from '../../data/site';
import { withBase } from '../../utils/url';

const currentPath = Astro.url.pathname;
const isActive = (href: string) => {
  const target = withBase(href);
  if (href === '/') {
    return currentPath === target || currentPath === target.replace(/\/$/, '');
  }

  return currentPath.startsWith(target);
};
---

<header class="site-header">
  <div class="header-inner shell">
    <a class="brand" href={withBase('')} aria-label={`${site.name} 首页`}>
      <span>{site.name}</span>
      <small>Portfolio & Notes</small>
    </a>

    <nav aria-label="主导航">
      <ul class="nav-list">
        {navigation.map((item) => (
          <li>
            <a
              class:list={['nav-link', { active: isActive(item.href) }]}
              href={withBase(item.href)}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <a class="header-contact" href={`mailto:${site.email}`}>联系我</a>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    z-index: 20;
    top: 0;
    border-bottom: 1px solid var(--color-border);
    background: rgba(248, 242, 232, 0.8);
    backdrop-filter: blur(18px);
  }

  .header-inner {
    display: grid;
    min-height: 4.7rem;
    grid-template-columns: 1fr auto 1fr;
    gap: var(--space-5);
    align-items: center;
  }

  .brand {
    display: flex;
    width: max-content;
    flex-direction: column;
    line-height: 1.1;
  }

  .brand span {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 750;
  }

  .brand small {
    margin-top: 0.2rem;
    color: var(--color-text-faint);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .nav-list {
    display: flex;
    gap: var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-link {
    position: relative;
    display: block;
    padding-block: 0.5rem;
    color: var(--color-text-soft);
    font-size: 0.86rem;
    font-weight: 650;
  }

  .nav-link::after {
    position: absolute;
    right: 0;
    bottom: 0.25rem;
    left: 0;
    height: 1px;
    background: var(--color-accent-strong);
    content: '';
    opacity: 0;
    transform: scaleX(0.4);
    transition: opacity var(--transition), transform var(--transition);
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--color-accent-strong);
  }

  .nav-link:hover::after,
  .nav-link.active::after {
    opacity: 1;
    transform: scaleX(1);
  }

  .header-contact {
    justify-self: end;
    padding: 0.5rem 0.85rem;
    border: 1px solid var(--color-border-strong);
    border-radius: 999px;
    background: rgba(255, 251, 243, 0.55);
    font-size: 0.8rem;
    font-weight: 700;
  }

  .header-contact:hover {
    border-color: var(--color-accent);
    color: var(--color-accent-strong);
  }

  @media (max-width: 760px) {
    .header-inner {
      min-height: auto;
      grid-template-columns: 1fr;
      gap: var(--space-2);
      padding-block: var(--space-3);
    }

    nav {
      width: 100%;
      min-width: 0;
    }

    .brand small,
    .header-contact {
      display: none;
    }

    .nav-list {
      width: 100%;
      flex-wrap: wrap;
      justify-content: flex-start;
      gap: var(--space-1) var(--space-5);
    }

    .nav-link {
      font-size: 0.78rem;
    }
  }
</style>
