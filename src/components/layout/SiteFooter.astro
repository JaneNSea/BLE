---
import { site } from '../../data/site';
import { withBase } from '../../utils/url';
---

<footer class="site-footer">
  <div class="footer-inner shell">
    <div>
      <p class="footer-title">感谢你花时间了解我的工作。</p>
      <p class="footer-note">如果某个项目或想法让你感兴趣，欢迎直接来信。</p>
    </div>
    <div class="footer-links">
      <a href={`mailto:${site.email}`}>{site.email}</a>
      <span><a href={site.social.github} rel="noreferrer" target="_blank">GitHub</a> · <a href={withBase('about/')}>关于</a></span>
      <small>© {new Date().getFullYear()} {site.name}</small>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    background: rgba(235, 224, 205, 0.42);
  }

  .footer-inner {
    display: flex;
    justify-content: space-between;
    gap: var(--space-7);
    padding-block: var(--space-7);
  }

  .footer-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 3vw, 1.9rem);
    font-weight: 650;
  }

  .footer-note {
    margin: var(--space-2) 0 0;
    color: var(--color-text-soft);
    font-size: 0.86rem;
  }

  .footer-links {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--space-2);
    color: var(--color-text-soft);
    font-size: 0.82rem;
  }

  .footer-links > a {
    color: var(--color-accent-strong);
    font-weight: 650;
  }

  .footer-links small {
    color: var(--color-text-faint);
  }

  @media (max-width: 620px) {
    .footer-inner {
      flex-direction: column;
    }

    .footer-links {
      align-items: flex-start;
    }
  }
</style>
