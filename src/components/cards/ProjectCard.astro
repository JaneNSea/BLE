---
import type { ProjectEntry } from '../../utils/content';
import { withBase } from '../../utils/url';
import TagList from '../ui/TagList.astro';

interface Props {
  entry: ProjectEntry;
}

const { entry } = Astro.props;
const typeLabels = {
  course: '课程设计',
  personal: '个人项目',
  experiment: '技术实验',
  'open-source': '开源项目',
};
---

<article class="project-card content-card">
  {entry.data.cover ? (
    <img class="project-cover" src={withBase(entry.data.cover)} alt="" loading="lazy" />
  ) : (
    <div class="project-cover project-cover--placeholder" aria-hidden="true">
      <span>{String(entry.data.year).slice(-2)}</span>
      <small>{typeLabels[entry.data.type]}</small>
    </div>
  )}
  <div class="project-content">
    <div class="meta-line">
      <span>{typeLabels[entry.data.type]}</span>
      <span>{entry.data.year}</span>
      <span>{entry.data.status}</span>
    </div>
    <h3><a href={withBase(`projects/${entry.id}/`)}>{entry.data.title}</a></h3>
    <p>{entry.data.summary}</p>
    <div class="project-bottom">
      <TagList tags={entry.data.tags} />
      <span class="read-more">查看项目 →</span>
    </div>
  </div>
</article>

<style>
  .project-card {
    grid-column: span 6;
  }

  .project-cover {
    width: 100%;
    height: 12rem;
    border-bottom: 1px solid var(--color-border);
    object-fit: cover;
  }

  .project-cover--placeholder {
    display: flex;
    align-items: end;
    justify-content: space-between;
    padding: var(--space-5);
    color: #584528;
    background: linear-gradient(145deg, #ead8b8, #d7ba82);
  }

  .project-cover--placeholder span {
    font-family: var(--font-display);
    font-size: 5rem;
    line-height: 0.75;
    opacity: 0.28;
  }

  .project-cover--placeholder small {
    font-size: 0.7rem;
    font-weight: 750;
    letter-spacing: 0.1em;
  }

  .project-content {
    display: flex;
    min-height: 18rem;
    flex-direction: column;
    padding: clamp(1.3rem, 3vw, 1.9rem);
  }

  .meta-line span + span::before {
    margin-right: var(--space-3);
    color: var(--color-accent);
    content: '•';
  }

  h3 {
    margin: var(--space-4) 0 0;
    font-family: var(--font-display);
    font-size: clamp(1.55rem, 3vw, 2.15rem);
    font-weight: 680;
    letter-spacing: -0.035em;
    line-height: 1.15;
  }

  h3 a::after {
    position: absolute;
    inset: 0;
    content: '';
  }

  p {
    margin: var(--space-3) 0 var(--space-5);
    color: var(--color-text-soft);
    font-size: 0.92rem;
  }

  .project-bottom {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    align-items: end;
    margin-top: auto;
  }

  .read-more {
    flex: none;
    color: var(--color-accent-strong);
    font-size: 0.78rem;
    font-weight: 700;
  }

  @media (max-width: 720px) {
    .project-card {
      grid-column: 1 / -1;
    }

    .project-bottom {
      align-items: start;
      flex-direction: column;
    }
  }
</style>
