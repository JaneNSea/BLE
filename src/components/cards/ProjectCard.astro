---
import type { ProjectEntry } from '../../utils/content';
import { withBase } from '../../utils/url';
import TagList from '../ui/TagList.astro';

interface Props {
  entry: ProjectEntry;
}

const { entry } = Astro.props;
const typeLabels = {
  course: 'Course Project',
  personal: 'Personal Project',
  experiment: 'Experiment',
  'open-source': 'Open Source',
};
---

<article class="project-card content-card">
  {entry.data.cover ? (
    <img class="project-cover" src={withBase(entry.data.cover)} alt="" loading="lazy" />
  ) : (
    <div class="project-index" aria-hidden="true">{String(entry.data.priority).padStart(2, '0')}</div>
  )}
  <div class="meta-line">
    <span>{typeLabels[entry.data.type]}</span>
    <span>·</span>
    <span>{entry.data.year}</span>
    <span>·</span>
    <span>{entry.data.status}</span>
  </div>
  <h3><a href={withBase(`projects/${entry.id}/`)}>{entry.data.title}</a></h3>
  <p>{entry.data.summary}</p>
  <div class="project-bottom">
    <TagList tags={entry.data.tags} />
    <span class="read-more">查看案例 →</span>
  </div>
</article>

<style>
  .project-card {
    display: flex;
    min-height: 25rem;
    flex-direction: column;
    grid-column: span 6;
    padding: clamp(1.4rem, 3vw, 2.2rem);
  }

  .project-index {
    display: grid;
    width: 3.2rem;
    height: 3.2rem;
    place-items: center;
    margin-bottom: auto;
    border: 1px solid var(--color-border);
    border-radius: 50%;
    color: var(--color-accent);
    background: var(--color-accent-soft);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  .project-cover {
    width: calc(100% + clamp(2.8rem, 6vw, 4.4rem));
    height: 11rem;
    margin: clamp(-2.2rem, -3vw, -1.4rem);
    margin-bottom: auto;
    border-bottom: 1px solid var(--color-border);
    object-fit: cover;
  }

  .meta-line {
    margin-top: var(--space-7);
  }

  h3 {
    margin: var(--space-4) 0 0;
    font-size: clamp(1.7rem, 4vw, 2.7rem);
    font-weight: 600;
    letter-spacing: -0.045em;
    line-height: 1.08;
  }

  h3 a::after {
    position: absolute;
    inset: 0;
    content: '';
  }

  p {
    margin: var(--space-4) 0 var(--space-6);
    color: var(--color-text-soft);
  }

  .project-bottom {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    align-items: end;
    margin-top: auto;
  }

  .read-more {
    flex: none;
    color: var(--color-accent);
    font-size: 0.8rem;
  }

  @media (max-width: 720px) {
    .project-card {
      min-height: 22rem;
      grid-column: 1 / -1;
    }

    .project-bottom {
      align-items: start;
      flex-direction: column;
    }
  }
</style>
