---
import type { NoteEntry } from '../../utils/content';
import { withBase } from '../../utils/url';

interface Props {
  entry: NoteEntry;
}

const { entry } = Astro.props;
const date = new Intl.DateTimeFormat('zh-CN', { year: 'numeric', month: '2-digit' }).format(
  entry.data.publishedAt,
);
---

<article class="note-row">
  <time datetime={entry.data.publishedAt.toISOString()}>{date}</time>
  <div>
    <h3><a href={withBase(`notes/${entry.id}/`)}>{entry.data.title}</a></h3>
    <p>{entry.data.summary}</p>
  </div>
  <div class="note-meta">
    <span>{entry.data.tags[0] ?? 'Note'}</span>
    {entry.data.readingMinutes && <span>{entry.data.readingMinutes} min</span>}
  </div>
  <span class="arrow" aria-hidden="true">↗</span>
</article>

<style>
  .note-row {
    position: relative;
    display: grid;
    grid-template-columns: 6rem minmax(0, 1fr) auto 1.5rem;
    gap: var(--space-5);
    align-items: start;
    padding-block: var(--space-5);
    border-top: 1px solid var(--color-border);
    transition: border-color var(--transition), padding-inline var(--transition);
  }

  .note-row:last-child {
    border-bottom: 1px solid var(--color-border);
  }

  .note-row:hover {
    padding-inline: var(--space-3);
    border-color: rgba(103, 245, 200, 0.35);
  }

  time,
  .note-meta {
    color: var(--color-text-faint);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  h3 {
    margin: 0;
    font-size: clamp(1.08rem, 2.5vw, 1.4rem);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.25;
  }

  h3 a::after {
    position: absolute;
    inset: 0;
    content: '';
  }

  p {
    max-width: 48rem;
    margin: var(--space-2) 0 0;
    color: var(--color-text-soft);
    font-size: 0.9rem;
  }

  .note-meta {
    display: flex;
    gap: var(--space-3);
  }

  .arrow {
    color: var(--color-accent);
  }

  @media (max-width: 700px) {
    .note-row {
      grid-template-columns: 1fr auto;
      gap: var(--space-3);
    }

    time {
      grid-column: 1;
    }

    .note-row > div:first-of-type {
      grid-column: 1 / -1;
    }

    .note-meta {
      grid-column: 1;
    }

    .arrow {
      grid-column: 2;
      grid-row: 1;
    }
  }
</style>
