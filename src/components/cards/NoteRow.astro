---
import type { NoteEntry } from '../../utils/content';
import { withBase } from '../../utils/url';

interface Props {
  entry: NoteEntry;
}

const { entry } = Astro.props;
const date = entry.data.publishedLabel ?? new Intl.DateTimeFormat('zh-CN', {
  year: 'numeric',
  month: '2-digit',
}).format(entry.data.publishedAt);
---

<article class="note-row">
  <time datetime={entry.data.publishedAt.toISOString()}>{date}</time>
  <div class="note-copy">
    <h3><a href={withBase(`notes/${entry.id}/`)}>{entry.data.title}</a></h3>
    <p>{entry.data.summary}</p>
  </div>
  <div class="note-meta">
    <span>{entry.data.tags[0] ?? '技术笔记'}</span>
    {entry.data.readingMinutes && <span>{entry.data.readingMinutes} 分钟</span>}
  </div>
</article>

<style>
  .note-row {
    position: relative;
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr) auto;
    gap: var(--space-4);
    align-items: start;
    padding-block: var(--space-5);
    border-top: 1px solid var(--color-border);
    transition: padding-inline var(--transition), background var(--transition);
  }

  .note-row:last-child {
    border-bottom: 1px solid var(--color-border);
  }

  .note-row:hover {
    padding-inline: var(--space-3);
    background: rgba(255, 251, 243, 0.4);
  }

  time,
  .note-meta {
    color: var(--color-text-faint);
    font-size: 0.7rem;
  }

  h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 2.5vw, 1.28rem);
    font-weight: 680;
    letter-spacing: -0.02em;
    line-height: 1.3;
  }

  h3 a::after {
    position: absolute;
    inset: 0;
    content: '';
  }

  p {
    margin: var(--space-2) 0 0;
    color: var(--color-text-soft);
    font-size: 0.84rem;
    line-height: 1.6;
  }

  .note-meta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--space-1);
  }

  @media (max-width: 620px) {
    .note-row {
      grid-template-columns: 1fr auto;
      gap: var(--space-2) var(--space-3);
    }

    .note-copy {
      grid-column: 1 / -1;
      grid-row: 2;
    }

    .note-meta {
      flex-direction: row;
      grid-column: 2;
      grid-row: 1;
    }
  }
</style>
