---
import type { NoteEntry } from '../../utils/content';
import { withBase } from '../../utils/url';

interface Props {
  entry: NoteEntry;
}

const { entry } = Astro.props;
const date = entry.data.publishedLabel ?? new Intl.DateTimeFormat('zh-CN', {
  year: 'numeric',
  month: '2-digit',
}).format(entry.data.publishedAt);
const listingTags = entry.data.listingTags.length > 0 ? entry.data.listingTags : entry.data.tags.slice(0, 2);
---

<article class="note-row">
  <time datetime={entry.data.publishedAt.toISOString()}>{date}</time>
  <div class="note-copy">
    <h3><a href={withBase(`notes/${entry.id}/`)}>{entry.data.title}</a></h3>
    <p>{entry.data.summary}</p>
  </div>
  {listingTags.length > 0 && (
    <ul class="note-tags" aria-label="文章分类">
      {listingTags.map((tag) => <li>{tag}</li>)}
    </ul>
  )}
</article>

<style>
  .note-row {
    position: relative;
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr) auto;
    gap: var(--space-4);
    align-items: start;
    padding-block: var(--space-5);
    border-top: 1px solid var(--color-border);
    transition: padding-inline var(--transition), background var(--transition);
  }

  .note-row:last-child {
    border-bottom: 1px solid var(--color-border);
  }

  .note-row:hover {
    padding-inline: var(--space-3);
    background: rgba(255, 251, 243, 0.4);
  }

  time {
    color: var(--color-text-faint);
    font-size: 0.7rem;
  }

  h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 2.5vw, 1.28rem);
    font-weight: 680;
    letter-spacing: -0.02em;
    line-height: 1.3;
  }

  h3 a::after {
    position: absolute;
    inset: 0;
    content: '';
  }

  p {
    margin: var(--space-2) 0 0;
    color: var(--color-text-soft);
    font-size: 0.84rem;
    line-height: 1.6;
  }

  .note-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    justify-content: flex-end;
    max-width: 11rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .note-tags li {
    padding: 0.22rem 0.5rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    color: var(--color-text-soft);
    background: rgba(255, 251, 243, 0.68);
    font-size: 0.64rem;
    line-height: 1.35;
    white-space: nowrap;
  }

  @media (max-width: 620px) {
    .note-row {
      grid-template-columns: 1fr auto;
      gap: var(--space-2) var(--space-3);
    }

    .note-copy {
      grid-column: 1 / -1;
      grid-row: 2;
    }

    .note-tags {
      grid-column: 2;
      grid-row: 1;
      max-width: 10rem;
    }
  }
</style>
