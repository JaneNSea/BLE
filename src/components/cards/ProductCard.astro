---
import type { ProductEntry } from '../../utils/content';
import { withBase } from '../../utils/url';
import TagList from '../ui/TagList.astro';

interface Props {
  entry: ProductEntry;
  prominent?: boolean;
}

const { entry, prominent = false } = Astro.props;
const visibility = {
  'closed-source': '闭源产品',
  'private-demo': '预约演示',
  'public-preview': '公开预览',
}[entry.data.visibility];
const status = {
  concept: 'Concept',
  building: 'Building',
  mvp: 'MVP',
  beta: 'Beta',
  completed: 'Completed',
  maintained: 'Maintained',
}[entry.data.status];
---

<article class:list={['product-card content-card', { prominent }]}>
  <div class="product-cover">
    {entry.data.cover ? (
      <img src={withBase(entry.data.cover)} alt={`${entry.data.title} 项目封面`} loading="lazy" decoding="async" />
    ) : (
      <div class="cover-placeholder">
        <small>Selected product</small>
        <span>{entry.data.title.slice(0, 1)}</span>
        <p>{entry.data.tagline}</p>
      </div>
    )}
  </div>

  <div class="product-content">
    <div class="product-meta">
      <span>{visibility}</span>
      <span>{status}</span>
      <span>{entry.data.role}</span>
    </div>
    <h3><a href={withBase(`products/${entry.id}/`)}>{entry.data.title}</a></h3>
    <p class="tagline">{entry.data.tagline}</p>
    <p class="summary">{entry.data.summary}</p>

    {entry.data.metrics.length > 0 && (
      <dl class="metrics">
        {entry.data.metrics.map((metric) => (
          <div>
            <dt>{metric.label}</dt>
            <dd>{metric.value}</dd>
          </div>
        ))}
      </dl>
    )}

    <div class="product-footer">
      <TagList tags={entry.data.tags} />
      <a class="product-link" href={withBase(`products/${entry.id}/`)}>{entry.data.ctaLabel} →</a>
    </div>
  </div>
</article>

<style>
  .product-card {
    display: grid;
    grid-template-columns: minmax(15rem, 0.8fr) minmax(0, 1.2fr);
    min-height: 28rem;
  }

  .product-cover {
    position: relative;
    min-height: 22rem;
    padding: var(--space-4);
    border-right: 1px solid var(--color-border);
    background: rgba(224, 201, 158, 0.22);
  }

  .product-cover > img,
  .cover-placeholder {
    width: 100%;
    height: 100%;
    border-radius: calc(var(--radius-lg) - 0.5rem);
    object-fit: cover;
  }

  .product-cover > img {
    position: absolute;
    inset: var(--space-4);
    width: calc(100% - (var(--space-4) * 2));
    height: calc(100% - (var(--space-4) * 2));
  }

  .cover-placeholder {
    display: flex;
    min-height: 20rem;
    flex-direction: column;
    justify-content: space-between;
    padding: var(--space-5);
    color: #4c3d28;
    background:
      radial-gradient(circle at 80% 15%, rgba(255, 255, 255, 0.48), transparent 10rem),
      linear-gradient(145deg, #ddc490, #c9a96e);
  }

  .cover-placeholder small {
    font-size: 0.7rem;
    font-weight: 750;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .cover-placeholder > span {
    font-family: var(--font-display);
    font-size: clamp(6rem, 14vw, 10rem);
    line-height: 0.8;
    opacity: 0.28;
  }

  .cover-placeholder p {
    max-width: 18rem;
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 650;
    line-height: 1.25;
  }

  .product-content {
    display: flex;
    min-width: 0;
    flex-direction: column;
    justify-content: center;
    padding: clamp(1.5rem, 4vw, 3rem);
  }

  .product-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    margin-bottom: var(--space-5);
    color: var(--color-text-faint);
    font-size: 0.72rem;
  }

  .product-meta span:not(:last-child)::after {
    margin-left: var(--space-4);
    color: var(--color-accent);
    content: '•';
  }

  h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3.4rem);
    font-weight: 680;
    letter-spacing: -0.045em;
    line-height: 1.05;
  }

  h3 a::after {
    position: absolute;
    inset: 0;
    content: '';
  }

  .tagline {
    margin: var(--space-4) 0 0;
    color: var(--color-accent-strong);
    font-weight: 700;
  }

  .summary {
    max-width: 38rem;
    margin: var(--space-3) 0 var(--space-5);
    color: var(--color-text-soft);
  }

  .metrics {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
    margin: 0 0 var(--space-6);
    padding-block: var(--space-4);
    border-block: 1px solid var(--color-border);
  }

  .metrics div + div {
    padding-left: var(--space-4);
    border-left: 1px solid var(--color-border);
  }

  dt {
    color: var(--color-text-faint);
    font-size: 0.68rem;
  }

  dd {
    margin: 0.15rem 0 0;
    color: var(--color-text);
    font-size: 0.86rem;
    font-weight: 700;
  }

  .product-footer {
    display: flex;
    justify-content: space-between;
    gap: var(--space-5);
    align-items: end;
  }

  .product-link {
    position: relative;
    z-index: 1;
    flex: none;
    color: var(--color-accent-strong);
    font-size: 0.84rem;
    font-weight: 750;
  }

  @media (max-width: 820px) {
    .product-card {
      grid-template-columns: 1fr;
      min-height: auto;
    }

    .product-cover {
      min-height: 18rem;
      border-right: 0;
      border-bottom: 1px solid var(--color-border);
    }

    .cover-placeholder {
      min-height: 17rem;
    }

    .product-footer {
      align-items: start;
      flex-direction: column;
    }
  }

  @media (max-width: 480px) {
    .metrics {
      grid-template-columns: 1fr;
    }

    .metrics div + div {
      padding: var(--space-3) 0 0;
      border-top: 1px solid var(--color-border);
      border-left: 0;
    }
  }
</style>
