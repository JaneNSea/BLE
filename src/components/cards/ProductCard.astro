---
import type { ProductEntry } from '../../utils/content';
import { withBase } from '../../utils/url';
import TagList from '../ui/TagList.astro';

interface Props {
  entry: ProductEntry;
  prominent?: boolean;
}

const { entry, prominent = false } = Astro.props;
const visibility = {
  'closed-source': 'Closed Source',
  'private-demo': 'Private Demo',
  'public-preview': 'Public Preview',
}[entry.data.visibility];
---

<article class:list={['product-card content-card', { prominent }]}>
  <div class="product-visual" aria-hidden="true">
    {entry.data.cover ? (
      <img src={withBase(entry.data.cover)} alt="" loading="lazy" />
    ) : (
      <>
        <div class="visual-orbit orbit-one"></div>
        <div class="visual-orbit orbit-two"></div>
        <div class="visual-core">{String(entry.data.priority).padStart(3, '0')}</div>
      </>
    )}
    <span class="visual-label">PRIVATE / PRODUCT</span>
  </div>
  <div class="product-content">
    <div class="product-topline">
      <span class="status-dot"></span>
      <span>{visibility}</span>
      <span>·</span>
      <span>{entry.data.status}</span>
    </div>
    <p class="eyebrow">Featured product</p>
    <h3><a href={withBase(`products/${entry.id}/`)}>{entry.data.title}</a></h3>
    <p class="tagline">{entry.data.tagline}</p>
    <p class="summary">{entry.data.summary}</p>

    {entry.data.metrics.length > 0 && (
      <dl class="metrics">
        {entry.data.metrics.map((metric) => (
          <div>
            <dt>{metric.label}</dt>
            <dd>{metric.value}</dd>
          </div>
        ))}
      </dl>
    )}

    <div class="product-footer">
      <TagList tags={entry.data.tags} />
      <a class="product-link" href={withBase(`products/${entry.id}/`)}>{entry.data.ctaLabel} →</a>
    </div>
  </div>
</article>

<style>
  .product-card {
    display: grid;
    grid-template-columns: minmax(16rem, 0.8fr) minmax(0, 1.2fr);
    min-height: 33rem;
  }

  .product-card.prominent {
    min-height: 38rem;
  }

  .product-visual {
    position: relative;
    overflow: hidden;
    min-height: 19rem;
    border-right: 1px solid var(--color-border);
    background:
      radial-gradient(circle at center, rgba(103, 245, 200, 0.18), transparent 32%),
      linear-gradient(150deg, #121a1a, #090d0f);
  }

  .product-visual::before,
  .product-visual::after {
    position: absolute;
    content: '';
  }

  .product-visual img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .product-visual::before {
    inset: 0;
    background-image:
      linear-gradient(rgba(103, 245, 200, 0.09) 1px, transparent 1px),
      linear-gradient(90deg, rgba(103, 245, 200, 0.09) 1px, transparent 1px);
    background-size: 36px 36px;
    mask-image: radial-gradient(circle, black, transparent 72%);
  }

  .product-visual::after {
    width: 0.5rem;
    height: 0.5rem;
    top: 2rem;
    right: 2rem;
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow: 0 0 20px var(--color-accent);
  }

  .visual-orbit {
    position: absolute;
    inset: 50%;
    border: 1px solid rgba(103, 245, 200, 0.28);
    border-radius: 50%;
    transform: translate(-50%, -50%);
  }

  .orbit-one {
    width: 14rem;
    height: 14rem;
  }

  .orbit-two {
    width: 22rem;
    height: 22rem;
    border-style: dashed;
  }

  .visual-core {
    position: absolute;
    top: 50%;
    left: 50%;
    display: grid;
    width: 6rem;
    height: 6rem;
    place-items: center;
    border: 1px solid var(--color-accent);
    border-radius: 50%;
    color: var(--color-accent);
    background: rgba(9, 13, 15, 0.8);
    box-shadow: 0 0 60px rgba(103, 245, 200, 0.16);
    font-family: var(--font-mono);
    transform: translate(-50%, -50%);
  }

  .visual-label {
    position: absolute;
    bottom: 1.5rem;
    left: 1.5rem;
    color: var(--color-text-faint);
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.15em;
  }

  .product-content {
    display: flex;
    min-width: 0;
    flex-direction: column;
    padding: clamp(1.5rem, 4vw, 3.5rem);
  }

  .product-topline {
    display: flex;
    gap: var(--space-2);
    align-items: center;
    margin-bottom: auto;
    color: var(--color-text-faint);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    text-transform: uppercase;
  }

  .status-dot {
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow: 0 0 12px rgba(103, 245, 200, 0.7);
  }

  h3 {
    max-width: 12ch;
    margin: 0;
    font-size: clamp(2.3rem, 5vw, 4.4rem);
    font-weight: 600;
    letter-spacing: -0.055em;
    line-height: 1;
  }

  h3 a::after {
    position: absolute;
    inset: 0;
    content: '';
  }

  .tagline {
    margin: var(--space-4) 0 0;
    color: var(--color-text);
    font-size: 1.12rem;
    font-weight: 600;
  }

  .summary {
    max-width: 38rem;
    margin: var(--space-3) 0 var(--space-5);
    color: var(--color-text-soft);
  }

  .metrics {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-3);
    margin: 0 0 var(--space-6);
  }

  .metrics div {
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border);
  }

  dt {
    color: var(--color-text-faint);
    font-size: 0.68rem;
  }

  dd {
    margin: 0.15rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.82rem;
  }

  .product-footer {
    display: flex;
    justify-content: space-between;
    gap: var(--space-5);
    align-items: end;
  }

  .product-link {
    position: relative;
    z-index: 1;
    flex: none;
    color: var(--color-accent);
    font-size: 0.85rem;
    font-weight: 650;
  }

  @media (max-width: 820px) {
    .product-card {
      grid-template-columns: 1fr;
      min-height: auto;
    }

    .product-card.prominent {
      min-height: auto;
    }

    .product-visual {
      border-right: 0;
      border-bottom: 1px solid var(--color-border);
    }

    .product-topline {
      margin-bottom: var(--space-7);
    }

    .product-footer {
      align-items: start;
      flex-direction: column;
    }
  }

  @media (max-width: 480px) {
    .metrics {
      grid-template-columns: 1fr;
    }
  }
</style>
