---
import { withBase } from '../../utils/url';

interface Props {
  eyebrow: string;
  title: string;
  description?: string;
  href?: string;
  linkLabel?: string;
}

const { eyebrow, title, description, href, linkLabel = '查看全部' } = Astro.props;
---

<div class="section-heading">
  <div>
    <p class="eyebrow">{eyebrow}</p>
    <h2>{title}</h2>
    {description && <p class="section-description">{description}</p>}
  </div>
  {href && <a class="section-link" href={withBase(href)}>{linkLabel}<span>→</span></a>}
</div>

<style>
  .section-heading {
    display: flex;
    justify-content: space-between;
    gap: var(--space-6);
    align-items: end;
    margin-bottom: var(--space-6);
  }

  h2 {
    max-width: 20ch;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 4vw, 3.1rem);
    font-weight: 650;
    letter-spacing: -0.04em;
    line-height: 1.12;
  }

  .section-description {
    max-width: 40rem;
    margin: var(--space-3) 0 0;
    color: var(--color-text-soft);
  }

  .section-link {
    display: inline-flex;
    flex: none;
    gap: var(--space-2);
    align-items: center;
    color: var(--color-accent-strong);
    font-size: 0.84rem;
    font-weight: 700;
  }

  .section-link span {
    transition: transform var(--transition);
  }

  .section-link:hover span {
    transform: translateX(3px);
  }

  @media (max-width: 620px) {
    .section-heading {
      align-items: start;
      flex-direction: column;
    }
  }
</style>
