---
import { withBase } from '../../utils/url';

interface Props {
  src: string;
  alt: string;
}

const { src, alt } = Astro.props;
const imageUrl = withBase(src);
---

<div class="product-image-reveal">
  <button
    class="image-trigger"
    type="button"
    data-product-image-open
    aria-label={`查看完整图片：${alt}`}
  >
    <img class="image-crop" src={imageUrl} alt="" aria-hidden="true" loading="lazy" decoding="async" />
    <img class="image-full" src={imageUrl} alt={alt} loading="lazy" decoding="async" />
    <span class="image-hint">
      <small>悬停查看完整构图</small>
      <strong>点击放大 ↗</strong>
    </span>
  </button>

  <dialog data-product-image-dialog aria-label={`${alt}大图`}>
    <div class="dialog-bar">
      <span>{alt}</span>
      <button type="button" data-product-image-close aria-label="关闭大图">关闭 ×</button>
    </div>
    <img src={imageUrl} alt={alt} />
  </dialog>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.product-image-reveal').forEach((reveal) => {
    const open = reveal.querySelector<HTMLButtonElement>('[data-product-image-open]');
    const dialog = reveal.querySelector<HTMLDialogElement>('[data-product-image-dialog]');
    const close = reveal.querySelector<HTMLButtonElement>('[data-product-image-close]');
    if (!open || !dialog || !close) return;

    open.addEventListener('click', () => dialog.showModal());
    close.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
  });
</script>

<style>
  .product-image-reveal,
  .image-trigger {
    width: 100%;
    height: 100%;
  }

  .image-trigger {
    position: relative;
    z-index: 2;
    display: block;
    overflow: hidden;
    padding: 0;
    border: 0;
    border-radius: calc(var(--radius-lg) - 0.5rem);
    cursor: zoom-in;
    background: #eee3d1;
  }

  .image-trigger img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    margin: 0;
    border: 0;
    border-radius: 0;
    transition: opacity 320ms ease, transform 420ms ease;
  }

  .image-crop {
    object-fit: cover;
    opacity: 1;
    transform: scale(1.01);
  }

  .image-full {
    padding: var(--space-3);
    object-fit: contain;
    opacity: 0;
    transform: scale(0.92);
  }

  .image-trigger:hover .image-crop,
  .image-trigger:focus-visible .image-crop {
    opacity: 0;
    transform: scale(1.06);
  }

  .image-trigger:hover .image-full,
  .image-trigger:focus-visible .image-full {
    opacity: 1;
    transform: scale(1);
  }

  .image-hint {
    position: absolute;
    z-index: 3;
    right: var(--space-3);
    bottom: var(--space-3);
    left: var(--space-3);
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    align-items: center;
    padding: 0.62rem 0.75rem;
    border: 1px solid rgba(255, 255, 255, 0.48);
    border-radius: 999px;
    color: #fffdf8;
    background: rgba(49, 40, 28, 0.74);
    backdrop-filter: blur(12px);
    transition: background var(--transition), transform var(--transition);
  }

  .image-hint small {
    font-size: 0.62rem;
    letter-spacing: 0.04em;
  }

  .image-hint strong {
    flex: none;
    font-size: 0.68rem;
  }

  .image-trigger:hover .image-hint,
  .image-trigger:focus-visible .image-hint {
    color: #4b381b;
    background: rgba(255, 250, 240, 0.88);
    transform: translateY(-2px);
  }

  dialog {
    width: min(calc(100vw - 2rem), 76rem);
    max-width: none;
    max-height: calc(100vh - 2rem);
    padding: 0;
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: var(--radius-md);
    color: #fff;
    background: #211d18;
    box-shadow: 0 32px 90px rgba(20, 15, 10, 0.4);
  }

  dialog::backdrop {
    background: rgba(29, 24, 18, 0.76);
    backdrop-filter: blur(8px);
  }

  dialog img {
    display: block;
    width: 100%;
    max-height: calc(100vh - 6rem);
    margin: 0;
    object-fit: contain;
    background: #f2eadc;
  }

  .dialog-bar {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    align-items: center;
    padding: 0.75rem 1rem;
    font-size: 0.78rem;
  }

  .dialog-bar button {
    padding: 0.35rem 0.6rem;
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 999px;
    color: inherit;
    cursor: pointer;
    background: transparent;
    font: inherit;
  }

  @media (max-width: 520px) {
    .image-hint small {
      display: none;
    }

    .image-hint {
      left: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .image-trigger img,
    .image-hint {
      transition: none;
    }
  }
</style>
