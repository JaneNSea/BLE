---
import BaseLayout from './BaseLayout.astro';
import { withBase } from '../utils/url';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Author {
  name: string;
  role?: string;
  avatar?: string;
  url?: string;
}

interface Props {
  eyebrow: string;
  title: string;
  summary: string;
  publishedAt: Date;
  publishedLabel?: string;
  updatedAt?: Date;
  tags?: string[];
  authors?: Author[];
  headings?: Heading[];
  cover?: string;
  coverAlt?: string;
  coverPosition?: string;
  backHref: string;
  backLabel: string;
  status?: string;
}

const {
  eyebrow,
  title,
  summary,
  publishedAt,
  publishedLabel,
  updatedAt,
  tags = [],
  authors = [],
  headings = [],
  cover,
  coverAlt = `${title} 技术笔记视觉`,
  coverPosition = '50% 50%',
  backHref,
  backLabel,
  status,
} = Astro.props;
const formatter = new Intl.DateTimeFormat('zh-CN', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
});
const displayDate = publishedLabel ?? formatter.format(publishedAt);
const chapters = headings.filter((heading) => heading.depth >= 2 && heading.depth <= 3).slice(0, 8);
const initialsFor = (name: string) => name.trim().slice(0, 2).toUpperCase();
---

<BaseLayout title={`${title} — ${eyebrow}`} description={summary} math>
  <article>
    <header class="content-hero shell">
      <a class="back-link" href={withBase(backHref)}>← {backLabel}</a>
      <div class:list={['hero-grid', { 'has-visual': cover }]}>
        <div class="hero-copy">
          <p class="eyebrow">{eyebrow}</p>
          <h1 class="page-title">{title}</h1>
          {authors.length > 0 && (
            <ul class="author-list" aria-label="作者">
              {authors.map((author) => (
                <li>
                  {author.avatar ? (
                    <img src={withBase(author.avatar)} alt="" width="36" height="36" loading="eager" />
                  ) : (
                    <span class="author-initials" aria-hidden="true">{initialsFor(author.name)}</span>
                  )}
                  <span class="author-copy">
                    {author.url ? (
                      <a href={author.url} target="_blank" rel="noreferrer">{author.name}</a>
                    ) : (
                      <strong>{author.name}</strong>
                    )}
                    {author.role && <small>{author.role}</small>}
                  </span>
                </li>
              ))}
            </ul>
          )}
          <p class="lede">{summary}</p>
          <div class="meta-row">
            <span>发布于 {displayDate}</span>
            {updatedAt && <span>更新于 {formatter.format(updatedAt)}</span>}
            {status && <span>{status}</span>}
          </div>
        </div>

        {cover && (
          <figure class="note-visual">
            <img
              src={withBase(cover)}
              alt={coverAlt}
              style={`object-position: ${coverPosition};`}
              width="640"
              height="640"
              loading="eager"
              decoding="async"
            />
          </figure>
        )}
      </div>
    </header>

    <div class="content-body shell">
      <aside class="note-aside" aria-label="文章边注">
        <div class="aside-section">
          <p>Published</p>
          <strong>{displayDate}</strong>
          {status && <span>{status}</span>}
        </div>

        {tags.length > 0 && (
          <div class="aside-section">
            <p>Topics</p>
            <ul class="aside-tags">
              {tags.map((tag) => <li>{tag}</li>)}
            </ul>
          </div>
        )}

        {chapters.length > 0 && (
          <nav class="aside-section toc-section" aria-label="文章目录">
            <p>Notes</p>
            <ol class="aside-toc">
              {chapters.map((heading) => (
                <li class={`depth-${heading.depth}`}>
                  <a href={`#${heading.slug}`}>{heading.text}</a>
                </li>
              ))}
            </ol>
          </nav>
        )}
      </aside>
      <div class="prose"><slot /></div>
    </div>
  </article>
</BaseLayout>

<style>
  .content-hero {
    padding-block: var(--space-7) var(--space-6);
    border-bottom: 1px solid var(--color-border);
  }

  .back-link {
    display: inline-flex;
    margin-bottom: var(--space-6);
    color: var(--color-text-soft);
    font-size: 0.9rem;
    transition: color var(--transition);
  }

  .back-link:hover {
    color: var(--color-accent-strong);
  }

  .hero-grid {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .hero-grid.has-visual {
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.36fr);
  }

  .hero-copy {
    min-width: 0;
  }

  .hero-copy .lede {
    max-width: 45rem;
  }

  .meta-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin: var(--space-4) 0 0;
    color: var(--color-text-faint);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .author-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin: var(--space-4) 0 0;
    padding: 0;
    list-style: none;
  }

  .author-list li {
    display: inline-flex;
    min-width: 0;
    align-items: center;
    gap: var(--space-2);
  }

  .author-list img,
  .author-initials {
    flex: 0 0 auto;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--color-border-strong);
    border-radius: 50%;
    background: rgba(255, 251, 243, 0.72);
  }

  .author-list img {
    object-fit: cover;
  }

  .author-initials {
    display: grid;
    place-items: center;
    color: var(--color-accent-strong);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 800;
  }

  .author-copy {
    display: grid;
    min-width: 0;
    line-height: 1.25;
  }

  .author-copy strong,
  .author-copy a {
    color: var(--color-text);
    font-size: 0.84rem;
    font-weight: 720;
  }

  .author-copy a:hover {
    color: var(--color-accent-strong);
  }

  .author-copy small {
    color: var(--color-text-faint);
    font-size: 0.68rem;
  }

  .note-visual {
    position: relative;
    justify-self: end;
    width: min(100%, 22rem);
    aspect-ratio: 16 / 10;
    margin: 0;
    transform: rotate(1.2deg);
  }

  .note-visual::before,
  .note-visual::after {
    position: absolute;
    content: '';
    pointer-events: none;
  }

  .note-visual::before {
    z-index: -1;
    inset: 14% -4% -12% 10%;
    border: 1px solid rgba(91, 70, 41, 0.18);
    background: rgba(198, 160, 91, 0.16);
    clip-path: polygon(4% 0, 100% 7%, 96% 84%, 86% 100%, 0 92%, 2% 19%);
    transform: rotate(-6deg);
  }

  .note-visual::after {
    top: -0.55rem;
    left: 35%;
    width: 5.5rem;
    height: 1.1rem;
    border: 1px solid rgba(124, 89, 38, 0.12);
    background: rgba(182, 135, 60, 0.28);
    transform: rotate(-7deg);
  }

  .note-visual img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    border: 1px solid rgba(91, 70, 41, 0.18);
    box-shadow: 0 16px 36px rgba(83, 57, 23, 0.12);
    clip-path: polygon(2% 0, 100% 5%, 97% 88%, 88% 100%, 0 94%, 1% 14%);
  }

  .content-body {
    display: grid;
    grid-template-columns: minmax(9rem, 0.24fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
    padding-block: var(--space-8) var(--space-9);
  }

  .prose {
    width: min(100%, var(--reading-width));
    margin: 0;
  }

  .note-aside {
    position: sticky;
    top: 6.5rem;
    display: grid;
    gap: var(--space-5);
    min-width: 0;
    padding-top: 0.25rem;
    color: var(--color-text-faint);
    font-size: 0.73rem;
  }

  .aside-section {
    display: grid;
    gap: var(--space-2);
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border);
  }

  .aside-section p {
    margin: 0;
    color: var(--color-accent-strong);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 750;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .aside-section strong {
    color: var(--color-text);
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 650;
    line-height: 1.25;
  }

  .aside-section span {
    line-height: 1.45;
  }

  .aside-tags,
  .aside-toc {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .aside-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .aside-tags li {
    padding: 0.18rem 0.45rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    color: var(--color-text-soft);
    background: rgba(255, 251, 243, 0.42);
    line-height: 1.4;
  }

  .aside-toc {
    display: grid;
    gap: 0.48rem;
  }

  .aside-toc li {
    line-height: 1.45;
  }

  .aside-toc .depth-3 {
    padding-left: 0.75rem;
  }

  .aside-toc a {
    color: var(--color-text-soft);
    transition: color var(--transition);
  }

  .aside-toc a:hover {
    color: var(--color-accent-strong);
  }

  @media (max-width: 860px) {
    .hero-grid.has-visual,
    .content-body {
      grid-template-columns: 1fr;
    }

    .note-visual {
      justify-self: start;
      width: min(84vw, 22rem);
    }

    .note-aside {
      position: static;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-4);
      order: -1;
    }

    .toc-section {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 560px) {
    .note-aside {
      grid-template-columns: 1fr;
    }

    .note-visual {
      width: min(88vw, 20rem);
    }
  }
</style>
