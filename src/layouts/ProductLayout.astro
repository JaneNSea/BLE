---
import BaseLayout from './BaseLayout.astro';
import TagList from '../components/ui/TagList.astro';
import { withBase } from '../utils/url';

interface Metric {
  label: string;
  value: string;
}

interface Props {
  title: string;
  tagline: string;
  summary: string;
  cover?: string;
  coverAlt?: string;
  status: string;
  tags?: string[];
  metrics?: Metric[];
  backHref: string;
  backLabel: string;
}

const {
  title,
  tagline,
  summary,
  cover,
  coverAlt = `${title} 产品视觉`,
  status,
  tags = [],
  metrics = [],
  backHref,
  backLabel,
} = Astro.props;
---

<BaseLayout title={`${title} — Product`} description={summary}>
  <article class="product-page">
    <header class="product-hero">
      <div class="hero-shell shell">
        <div class="hero-copy">
          <a class="back-link" href={withBase(backHref)}>← {backLabel}</a>
          <p class="product-kicker">Product · {status}</p>
          <h1>{title}</h1>
          <p class="tagline">{tagline}</p>
          <p class="summary">{summary}</p>
          <div class="hero-actions">
            <a class="button button--primary" href="#product-overview">了解产品</a>
            <a class="text-link" href="#product-progress">查看当前进展 ↓</a>
          </div>
          <TagList tags={tags} />
        </div>

        {cover && (
          <figure class="hero-visual">
            <div class="visual-label"><span>SuperMe</span><span>MVP / 2026</span></div>
            <a href={withBase(cover)} target="_blank" rel="noreferrer" aria-label="查看完整产品视觉">
              <img src={withBase(cover)} alt={coverAlt} loading="eager" decoding="async" />
            </a>
            <figcaption><span>Agent service marketplace · trusted delivery</span><span>查看完整视觉 ↗</span></figcaption>
          </figure>
        )}
      </div>

      {metrics.length > 0 && (
        <dl class="product-metrics shell">
          {metrics.map((metric, index) => (
            <div>
              <dt>{String(index + 1).padStart(2, '0')} · {metric.label}</dt>
              <dd>{metric.value}</dd>
            </div>
          ))}
        </dl>
      )}
    </header>

    <div class="product-story shell">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .product-page {
    --content-width: 66rem;
    --product-ink: #3c3022;
    --product-accent: #a9782d;
    --product-accent-soft: rgba(194, 151, 75, 0.13);
    --product-surface: rgba(255, 251, 243, 0.72);
  }

  .product-hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(2rem, 5vw, 4rem) var(--space-7);
    border-bottom: 1px solid var(--color-border);
  }

  .product-hero::before,
  .product-hero::after {
    position: absolute;
    border: 1px solid rgba(169, 120, 45, 0.15);
    border-radius: 50%;
    content: '';
    pointer-events: none;
  }

  .product-hero::before {
    width: 28rem;
    height: 28rem;
    top: -17rem;
    right: -6rem;
  }

  .product-hero::after {
    width: 13rem;
    height: 13rem;
    right: 31%;
    bottom: -9rem;
  }

  .hero-shell {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(21rem, 0.92fr);
    gap: clamp(2rem, 6vw, 5.5rem);
    align-items: center;
  }

  .back-link {
    display: inline-flex;
    margin-bottom: clamp(2.5rem, 6vw, 5rem);
    color: var(--color-text-soft);
    font-size: 0.82rem;
    transition: color var(--transition);
  }

  .back-link:hover,
  .text-link:hover {
    color: var(--product-accent);
  }

  .product-kicker {
    margin: 0 0 var(--space-4);
    color: var(--product-accent);
    font: 750 0.7rem var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    color: var(--product-ink);
    font-family: var(--font-display);
    font-size: clamp(4rem, 8vw, 7.5rem);
    font-weight: 650;
    letter-spacing: -0.065em;
    line-height: 0.86;
  }

  .tagline {
    max-width: 28rem;
    margin: var(--space-6) 0 var(--space-3);
    color: var(--product-ink);
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.7vw, 2rem);
    font-weight: 650;
    line-height: 1.25;
  }

  .summary {
    max-width: 39rem;
    margin: 0;
    color: var(--color-text-soft);
    font-size: 0.96rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    align-items: center;
    margin: var(--space-6) 0 var(--space-5);
  }

  .text-link {
    color: var(--color-text-soft);
    font-size: 0.82rem;
    font-weight: 700;
    transition: color var(--transition);
  }

  .hero-visual {
    position: relative;
    margin: 2rem 0 0;
    padding: var(--space-3);
    border: 1px solid rgba(91, 70, 41, 0.16);
    border-radius: 2rem;
    background: rgba(255, 250, 240, 0.52);
    box-shadow: 0 32px 80px rgba(87, 61, 25, 0.12);
    transform: rotate(1.2deg);
  }

  .hero-visual::before {
    position: absolute;
    z-index: -1;
    inset: 12% -8% -7% 17%;
    border-radius: inherit;
    background: rgba(209, 177, 115, 0.2);
    content: '';
    transform: rotate(-4deg);
  }

  .hero-visual img {
    width: 100%;
    aspect-ratio: 4 / 4.25;
    border-radius: 1.35rem;
    object-fit: cover;
  }

  .hero-visual > a { display: block; overflow: hidden; border-radius: 1.35rem; }

  .visual-label,
  .hero-visual figcaption {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    color: var(--color-text-faint);
    font: 650 0.6rem var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .visual-label { padding: 0.25rem 0.45rem 0.7rem; }
  .hero-visual figcaption { padding: 0.75rem 0.45rem 0.2rem; }

  .product-metrics {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin-top: clamp(3rem, 7vw, 6rem);
    margin-bottom: 0;
    border-block: 1px solid var(--color-border);
  }

  .product-metrics div { padding: var(--space-5) clamp(0rem, 2.5vw, 2rem); }
  .product-metrics div:first-child { padding-left: 0; }
  .product-metrics div + div { border-left: 1px solid var(--color-border); }
  .product-metrics dt { color: var(--color-text-faint); font: 650 0.63rem var(--font-mono); text-transform: uppercase; }
  .product-metrics dd { margin: var(--space-2) 0 0; color: var(--product-ink); font-family: var(--font-display); font-size: clamp(1rem, 2vw, 1.25rem); font-weight: 650; }

  .product-story {
    padding-block: var(--space-6) var(--space-9);
  }

  @media (max-width: 820px) {
    .hero-shell { grid-template-columns: 1fr; }
    .back-link { margin-bottom: var(--space-7); }
    .hero-copy { max-width: 42rem; }
    .hero-visual { width: min(100%, 35rem); margin: 0 auto; transform: none; }
  }

  @media (max-width: 620px) {
    .product-metrics { grid-template-columns: 1fr; }
    .product-metrics div { padding: var(--space-4) 0; }
    .product-metrics div + div { border-top: 1px solid var(--color-border); border-left: 0; }
    .hero-visual img { aspect-ratio: 4 / 3; }
    .hero-visual figcaption { display: none; }
  }
</style>
