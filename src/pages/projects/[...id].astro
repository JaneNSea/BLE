---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import ProjectLayout from '../../layouts/ProjectLayout.astro';
import { isPublished } from '../../utils/content';

export async function getStaticPaths() {
  const entries = (await getCollection('projects')).filter(isPublished);
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'projects'>;
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const statusLabel = {
  concept: '概念阶段',
  building: '开发中',
  mvp: 'MVP',
  beta: 'Beta',
  completed: '已完成',
  maintained: '持续维护',
}[entry.data.status];
---

<ProjectLayout
  title={entry.data.title}
  summary={entry.data.summary}
  period={entry.data.period ?? String(entry.data.year)}
  course={entry.data.course}
  tags={entry.data.tags}
  authors={entry.data.authors}
  headings={headings}
  repositories={entry.data.repositories}
  legacyRepo={entry.data.repo}
  testimonial={entry.data.testimonial}
  backHref="/projects/"
  backLabel="返回项目列表"
  status={statusLabel}
  role={entry.data.role}
>
  <Content />
  {entry.data.demo && (
    <div class="button-row">
      <a class="button" href={entry.data.demo}>在线演示 ↗</a>
    </div>
  )}
</ProjectLayout>
