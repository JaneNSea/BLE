---
import { getCollection } from 'astro:content';
import NoteRow from '../components/cards/NoteRow.astro';
import ProductCard from '../components/cards/ProductCard.astro';
import ProjectCard from '../components/cards/ProjectCard.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import RepoStar from '../components/ui/RepoStar.astro';
import CopyEmail from '../components/ui/CopyEmail.astro';
import { site } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import { byDate, byPriority, featured, isPublished } from '../utils/content';
import { withBase } from '../utils/url';

const [allProducts, allProjects, allNotes, allPrinciples] = await Promise.all([
  getCollection('products'),
  getCollection('projects'),
  getCollection('notes'),
  getCollection('principles'),
]);

const publishedProducts = allProducts.filter(isPublished).sort(byPriority);
const publishedProjects = allProjects.filter(isPublished).sort(byPriority);
const publishedNotes = allNotes.filter(isPublished).sort(byDate);
const featuredProduct = featured(allProducts)[0] ?? publishedProducts[0];
const selectedProjects = featured(allProjects).slice(0, 2);
const latestNotes = publishedNotes.slice(0, 4);
const principles = allPrinciples
  .filter((entry) => !entry.data.draft)
  .sort((a, b) => a.data.order - b.data.order);

const areas = [
  {
    index: '01',
    title: '商业产品',
    description: '了解闭源项目解决的问题、产品方案、架构决策和商业化方向。',
    href: '/products/',
    count: publishedProducts.length,
    unit: '个案例',
  },
  {
    index: '02',
    title: '学习项目',
    description: '浏览课程设计、个人 Demo 与开源实践的完整实现过程。',
    href: '/projects/',
    count: publishedProjects.length,
    unit: '个项目',
  },
  {
    index: '03',
    title: '技术笔记',
    description: '查看针对具体工程问题的分析、解法、代码与适用边界。',
    href: '/notes/',
    count: publishedNotes.length,
    unit: '篇文章',
  },
  {
    index: '04',
    title: '关于我',
    description: '认识我的技术方向、思考方式，以及做产品和工程判断的原则。',
    href: '/about/',
    count: principles.length,
    unit: '条原则',
  },
];
---

<BaseLayout>
  <section class="intro shell">
    <div class="intro-copy">
      <p class="eyebrow">Hello, this is {site.name}</p>
      <h1 class="display-title">我在这里记录做产品、写代码和解决问题的过程。</h1>
      <p class="lede">{site.description}</p>
      <div class="button-row">
        <a class="button button--primary" href="#explore">选择你想看的内容</a>
        <a class="button" href={site.social.github} rel="noreferrer" target="_blank">访问我的 GitHub 主页 ↗</a>
      </div>
    </div>

    <aside class="profile-card content-card" aria-label="个人简介">
      <img src={withBase(site.avatar)} alt={`${site.name} 的头像占位图`} width="112" height="112" />
      <div>
        <p class="profile-name">{site.name}</p>
        <p class="profile-role">{site.role}</p>
      </div>
      <p class="profile-status">{site.status}</p>
      <ul>
        {site.capabilities.slice(0, 4).map((capability) => <li>{capability}</li>)}
      </ul>
      <RepoStar />
    </aside>
  </section>

  <section id="explore" class="page-section shell explore-section">
    <div class="explore-intro">
      <p class="eyebrow">Explore</p>
      <h2>你想先了解哪一部分？</h2>
      <p>站内内容分成四个明确入口。你可以从目标出发，而不必按首页顺序一直往下翻。</p>
    </div>
    <nav class="area-grid" aria-label="内容分类">
      {areas.map((area) => (
        <a class="area-card" href={withBase(area.href)}>
          <span class="area-index">{area.index}</span>
          <div>
            <h3>{area.title}</h3>
            <p>{area.description}</p>
          </div>
          <span class="area-count">{area.count} {area.unit}</span>
          <span class="area-arrow" aria-hidden="true">→</span>
        </a>
      ))}
    </nav>
  </section>

  {featuredProduct && (
    <section class="page-section shell">
      <SectionHeading
        eyebrow="Selected product"
        title="当前重点产品"
        description="这里保留最重要的商业项目，但它是一个明确入口，而不是覆盖整个首页的视觉舞台。"
        href="/products/"
        linkLabel="查看所有产品"
      />
      <ProductCard entry={featuredProduct} prominent />
    </section>
  )}

  <section class="page-section shell recent-section">
    <div class="recent-projects">
      <SectionHeading
        eyebrow="Selected projects"
        title="精选学习项目"
        href="/projects/"
        linkLabel="全部项目"
      />
      {selectedProjects.length > 0 ? (
        <div class="cards-grid">
          {selectedProjects.map((entry) => <ProjectCard entry={entry} />)}
        </div>
      ) : (
        <div class="empty-state">精选项目会显示在这里。</div>
      )}
    </div>

    <div class="recent-notes">
      <SectionHeading
        eyebrow="Latest notes"
        title="最近的技术笔记"
        href="/notes/"
        linkLabel="全部笔记"
      />
      <div>{latestNotes.map((entry) => <NoteRow entry={entry} />)}</div>
    </div>
  </section>

  <section class="page-section shell principles-section">
    <div class="principles-intro">
      <p class="eyebrow">How I think</p>
      <h2>不只展示做过什么，也说明为什么这样做。</h2>
      <a href={withBase('about/')}>阅读完整介绍 →</a>
    </div>
    <ol class="principle-list">
      {principles.map((principle) => (
        <li>
          <span>{String(principle.data.order).padStart(2, '0')}</span>
          <div>
            <h3>{principle.data.title}</h3>
            <p>{principle.data.summary}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section class="contact-section shell">
    <div>
      <p class="eyebrow">Say hello</p>
      <h2>有想讨论的项目、职位或合作方向？</h2>
      <p>给我一封邮件，告诉我你从哪里看到这里，以及你对哪部分内容感兴趣。</p>
    </div>
    <CopyEmail label="复制邮箱地址" variant="primary" />
  </section>
</BaseLayout>

<style>
  .intro {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(17rem, 0.55fr);
    gap: var(--space-7);
    align-items: center;
    padding-block: var(--space-8) var(--space-7);
  }

  .intro > * {
    min-width: 0;
  }

  .profile-card {
    padding: var(--space-5);
  }

  .profile-card img {
    width: 5.5rem;
    height: 5.5rem;
    margin-bottom: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: 50%;
    object-fit: cover;
    background: var(--color-bg-soft);
  }

  .profile-name,
  .profile-role,
  .profile-status {
    margin: 0;
  }

  .profile-name {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 700;
  }

  .profile-role {
    color: var(--color-text-soft);
    font-size: 0.84rem;
  }

  .profile-status {
    margin-top: var(--space-5);
    padding-block: var(--space-4);
    border-block: 1px solid var(--color-border);
    color: var(--color-accent-strong);
    font-size: 0.85rem;
    font-weight: 650;
  }

  .profile-card ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-4) 0 0;
    padding: 0;
    list-style: none;
  }

  .profile-card li {
    padding: 0.3rem 0.55rem;
    border-radius: 999px;
    color: var(--color-text-soft);
    background: var(--color-accent-soft);
    font-size: 0.7rem;
  }

  .explore-section {
    display: grid;
    grid-template-columns: minmax(13rem, 0.45fr) minmax(0, 1.55fr);
    gap: var(--space-7);
    align-items: start;
  }

  .explore-intro {
    position: sticky;
    top: 7rem;
  }

  .explore-intro h2,
  .principles-intro h2,
  .contact-section h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3.2rem);
    font-weight: 650;
    letter-spacing: -0.04em;
    line-height: 1.12;
  }

  .explore-intro > p:last-child {
    color: var(--color-text-soft);
  }

  .area-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4);
  }

  .area-card {
    position: relative;
    display: flex;
    min-height: 18rem;
    flex-direction: column;
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: rgba(255, 251, 243, 0.66);
    box-shadow: var(--shadow-card);
    transition: border-color var(--transition), background var(--transition), transform var(--transition);
  }

  .area-card:hover {
    border-color: rgba(143, 106, 44, 0.32);
    background: var(--color-surface-strong);
    transform: translateY(-2px);
  }

  .area-index {
    color: var(--color-accent-strong);
    font-size: 0.72rem;
    font-weight: 800;
  }

  .area-card > div {
    margin-block: auto;
  }

  .area-card h3 {
    margin: 0 0 var(--space-3);
    font-family: var(--font-display);
    font-size: 1.8rem;
    line-height: 1.1;
  }

  .area-card p {
    margin: 0;
    color: var(--color-text-soft);
    font-size: 0.88rem;
  }

  .area-count {
    color: var(--color-text-faint);
    font-size: 0.72rem;
  }

  .area-arrow {
    position: absolute;
    right: var(--space-5);
    bottom: var(--space-5);
    color: var(--color-accent-strong);
    transition: transform var(--transition);
  }

  .area-card:hover .area-arrow {
    transform: translateX(4px);
  }

  .recent-section {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(20rem, 0.95fr);
    gap: var(--space-7);
  }

  .recent-section :global(.project-card) {
    grid-column: 1 / -1;
  }

  .recent-notes {
    padding-left: var(--space-7);
    border-left: 1px solid var(--color-border);
  }

  .principles-section {
    display: grid;
    grid-template-columns: 0.75fr 1.25fr;
    gap: var(--space-8);
  }

  .principles-intro a {
    display: inline-block;
    margin-top: var(--space-5);
    color: var(--color-accent-strong);
    font-size: 0.84rem;
    font-weight: 700;
  }

  .principle-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .principle-list li {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: var(--space-4);
    padding-block: var(--space-5);
    border-top: 1px solid var(--color-border);
  }

  .principle-list li > span {
    color: var(--color-accent-strong);
    font-size: 0.72rem;
    font-weight: 800;
  }

  .principle-list h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.35rem;
  }

  .principle-list p {
    margin: var(--space-2) 0 0;
    color: var(--color-text-soft);
    font-size: 0.9rem;
  }

  .contact-section {
    display: flex;
    justify-content: space-between;
    gap: var(--space-7);
    align-items: center;
    margin-block: var(--space-8);
    padding: clamp(1.5rem, 4vw, 3rem);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: rgba(226, 204, 164, 0.3);
  }

  .contact-section h2 {
    max-width: 22ch;
  }

  .contact-section div > p:last-child {
    margin: var(--space-3) 0 0;
    color: var(--color-text-soft);
  }

  .contact-section > :global(.copy-email) {
    flex: none;
  }

  @media (max-width: 900px) {
    .intro,
    .explore-section,
    .recent-section,
    .principles-section {
      grid-template-columns: 1fr;
    }

    .intro {
      padding-block: var(--space-8) var(--space-7);
    }

    .profile-card {
      display: grid;
      grid-template-columns: auto 1fr;
      gap: var(--space-4);
      align-items: center;
    }

    .profile-card img {
      margin: 0;
      grid-row: span 2;
    }

    .profile-status,
    .profile-card ul,
    .profile-card :global([data-repo-star]) {
      grid-column: 1 / -1;
    }

    .explore-intro {
      position: static;
    }

    .recent-notes {
      padding: var(--space-7) 0 0;
      border-top: 1px solid var(--color-border);
      border-left: 0;
    }
  }

  @media (max-width: 620px) {
    .area-grid {
      grid-template-columns: 1fr;
    }

    .area-card {
      min-height: 14rem;
    }

    .contact-section {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
