---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import ProductLayout from '../../layouts/ProductLayout.astro';
import { isPublished } from '../../utils/content';

export async function getStaticPaths() {
  const entries = (await getCollection('products')).filter(isPublished);
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'products'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const visibility = {
  'closed-source': 'Closed Source',
  'private-demo': 'Private Demo',
  'public-preview': 'Public Preview',
}[entry.data.visibility];
const status = {
  concept: 'Concept',
  building: 'Building',
  mvp: 'MVP',
  beta: 'Beta',
  completed: 'Completed',
  maintained: 'Maintained',
}[entry.data.status];
---

<ProductLayout
  title={entry.data.title}
  tagline={entry.data.tagline}
  summary={entry.data.summary}
  cover={entry.data.cover}
  coverAlt={`${entry.data.title} 产品概念视觉`}
  tags={entry.data.tags}
  metrics={entry.data.metrics}
  backHref="/products/"
  backLabel="返回产品列表"
  status={`${status} · ${visibility}`}
>
  <Content />
  {entry.data.demo && (
    <div class="button-row">
      <a class="button button--primary" href={entry.data.demo}>{entry.data.ctaLabel} ↗</a>
    </div>
  )}
</ProductLayout>
