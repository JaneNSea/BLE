---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import ContentLayout from '../../layouts/ContentLayout.astro';
import { isPublished } from '../../utils/content';

export async function getStaticPaths() {
  const entries = (await getCollection('products')).filter(isPublished);
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'products'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const visibility = {
  'closed-source': 'Closed Source',
  'private-demo': 'Private Demo',
  'public-preview': 'Public Preview',
}[entry.data.visibility];
const status = {
  concept: 'Concept',
  building: 'Building',
  mvp: 'MVP',
  beta: 'Beta',
  completed: 'Completed',
  maintained: 'Maintained',
}[entry.data.status];
---

<ContentLayout
  eyebrow="Product case study"
  title={entry.data.title}
  summary={entry.data.summary}
  publishedAt={entry.data.publishedAt}
  updatedAt={entry.data.updatedAt}
  tags={entry.data.tags}
  backHref="/products/"
  backLabel="返回产品列表"
  status={`${visibility} · ${status} · ${entry.data.role}`}
>
  {entry.data.metrics.length > 0 && (
    <dl class="case-metrics">
      {entry.data.metrics.map((metric) => (
        <div><dt>{metric.label}</dt><dd>{metric.value}</dd></div>
      ))}
    </dl>
  )}
  <Content />
  {entry.data.demo && (
    <div class="button-row">
      <a class="button button--primary" href={entry.data.demo}>{entry.data.ctaLabel} ↗</a>
    </div>
  )}
</ContentLayout>

<style>
  .case-metrics {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-3);
    margin: 0 0 var(--space-7);
  }

  .case-metrics div {
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
  }

  .case-metrics dt {
    color: var(--color-text-faint);
    font-size: 0.68rem;
  }

  .case-metrics dd {
    margin: var(--space-1) 0 0;
    color: var(--color-accent);
    font-family: var(--font-mono);
  }

  @media (max-width: 560px) {
    .case-metrics {
      grid-template-columns: 1fr;
    }
  }
</style>
