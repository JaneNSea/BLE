---
import RepoStar from '../components/ui/RepoStar.astro';
import { site } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';

const wallNotes = [
  {
    index: '01',
    title: '技术问题',
    body: '把你遇到的工程问题、选型纠结或实现细节钉在这里，我会尽量认真回复。',
    tone: 'green',
  },
  {
    index: '02',
    title: '产品想法',
    body: '如果你对平台、安全、国产生态或 AI 工作流有想法，也欢迎直接展开讨论。',
    tone: 'amber',
  },
  {
    index: '03',
    title: '公开边界',
    body: '留言会同步到 GitHub Issues，请不要留下隐私、密钥、账号或未公开项目信息。',
    tone: 'rose',
  },
];
---

<BaseLayout
  title="留言板 — JaneNSea"
  description="使用 GitHub Issues 保存的公开留言板。"
>
  <header class="comments-hero shell">
    <div>
      <p class="eyebrow">Guestbook / Message Wall</p>
      <h1 class="page-title">把想法钉在墙上，<br />让讨论慢慢长出来。</h1>
      <p class="lede">这里的留言公开保存在 GitHub Issues 中。你可以评论网站、讨论技术问题，也可以告诉我你正在做什么。</p>
    </div>

    <aside class="wall-preview" aria-label="留言墙提示">
      <span class="preview-pin" aria-hidden="true"></span>
      <p>PUBLIC WALL</p>
      <strong>GitHub 登录后留言</strong>
      <small>评论会成为公开 Issue 讨论的一部分。</small>
    </aside>
  </header>

  <section class="message-wall shell" aria-label="GitHub Issues 留言墙">
    <div class="board-screw screw-one" aria-hidden="true"></div>
    <div class="board-screw screw-two" aria-hidden="true"></div>
    <div class="board-screw screw-three" aria-hidden="true"></div>
    <div class="board-screw screw-four" aria-hidden="true"></div>

    <div class="wall-string" aria-hidden="true"></div>

    {wallNotes.map((note) => (
      <article class={`sticker sticker--${note.tone}`}>
        <span class="pin" aria-hidden="true"></span>
        <small>{note.index}</small>
        <h2>{note.title}</h2>
        <p>{note.body}</p>
      </article>
    ))}

    <aside class="sticker sticker--guide" aria-label="留言说明">
      <span class="pin" aria-hidden="true"></span>
      <small>BOARD GUIDE</small>
      <h2>留言说明</h2>
      <ol>
        <li><span>01</span><p>使用 GitHub 账号登录后发表评论。</p></li>
        <li><span>02</span><p>首次评论时，Utterances 会请求授权。</p></li>
        <li><span>03</span><p>评论数据公开保存在本站仓库的 Issues。</p></li>
      </ol>
      <a href={`${site.repository.url}/issues`} target="_blank" rel="noreferrer">直接查看 Issues ↗</a>
      <RepoStar compact />
    </aside>

    <section class="live-sticker" aria-labelledby="comment-title">
      <span class="pin pin-main" aria-hidden="true"></span>
      <div class="live-heading">
        <div>
          <p class="eyebrow">Live comments</p>
          <h2 id="comment-title">真实留言区</h2>
        </div>
        <span>PUBLIC</span>
      </div>

      <div class="utterances-wrap">
        <Fragment
          set:html={`<script src="https://utteranc.es/client.js" repo="${site.repository.slug}" issue-term="pathname" theme="boxy-light" crossorigin="anonymous" async><\/script>`}
        />
        <p class="comment-fallback">
          评论框没有显示？请先安装 Utterances，或
          <a href={`${site.repository.url}/issues`} target="_blank" rel="noreferrer">直接前往 GitHub Issues ↗</a>
        </p>
      </div>
    </section>
  </section>
</BaseLayout>

<style>
  .comments-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(15rem, 22rem);
    gap: var(--space-7);
    align-items: end;
    padding-block: var(--space-8) var(--space-7);
  }

  .wall-preview {
    position: relative;
    padding: var(--space-5);
    border: 1px solid rgba(91, 70, 41, 0.2);
    border-radius: 0.5rem;
    background: #fff8dd;
    box-shadow: 0 18px 45px rgba(85, 62, 30, 0.1);
    transform: rotate(1.2deg);
  }

  .wall-preview::before {
    position: absolute;
    top: -0.85rem;
    left: 50%;
    width: 4rem;
    height: 1.35rem;
    border: 1px solid rgba(113, 87, 52, 0.18);
    background: rgba(228, 198, 138, 0.74);
    content: '';
    transform: translateX(-50%) rotate(-4deg);
  }

  .preview-pin {
    position: absolute;
    top: 0.8rem;
    right: 1rem;
    width: 0.72rem;
    height: 0.72rem;
    border-radius: 50%;
    background: #b25a46;
    box-shadow: 0 2px 5px rgba(79, 53, 31, 0.28);
  }

  .wall-preview p,
  .wall-preview small {
    margin: 0;
    font-family: var(--font-mono);
  }

  .wall-preview p {
    color: var(--color-accent-strong);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
  }

  .wall-preview strong {
    display: block;
    margin-top: var(--space-4);
    font-family: var(--font-display);
    font-size: 1.8rem;
    line-height: 1.12;
  }

  .wall-preview small {
    display: block;
    margin-top: var(--space-4);
    color: var(--color-text-soft);
    font-size: 0.74rem;
  }

  .message-wall {
    position: relative;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(1rem, 3vw, 2rem);
    align-items: start;
    margin-bottom: var(--space-9);
    padding: clamp(1rem, 4vw, 3.25rem);
    border: 1px solid rgba(91, 70, 41, 0.3);
    border-radius: 0.5rem;
    background-color: #eadcc7;
    background-image:
      linear-gradient(120deg, rgba(255, 251, 243, 0.28), transparent 32%),
      radial-gradient(circle, rgba(70, 53, 34, 0.64) 1.8px, transparent 2.2px);
    background-position: 0 0, 4px 4px;
    background-size: auto, 34px 34px;
    box-shadow:
      inset 0 0 0 7px rgba(255, 251, 244, 0.45),
      inset 0 0 35px rgba(95, 67, 30, 0.13),
      0 24px 70px rgba(85, 62, 30, 0.12);
  }

  .board-screw {
    position: absolute;
    z-index: 3;
    width: 0.65rem;
    height: 0.65rem;
    border: 1px solid #7b6b57;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #fff, #9b8a72 55%, #5c5042);
    box-shadow: 0 1px 3px rgba(60, 45, 27, 0.35);
  }

  .screw-one { top: 1rem; left: 1rem; }
  .screw-two { top: 1rem; right: 1rem; }
  .screw-three { right: 1rem; bottom: 1rem; }
  .screw-four { bottom: 1rem; left: 1rem; }

  .wall-string {
    position: absolute;
    top: 5.4rem;
    right: 3rem;
    left: 3rem;
    height: 1px;
    background: rgba(91, 70, 41, 0.22);
    content: '';
    transform: rotate(-1.2deg);
  }

  .sticker,
  .live-sticker {
    position: relative;
    z-index: 1;
    min-width: 0;
    border: 1px solid rgba(81, 65, 45, 0.24);
    border-radius: 0.5rem;
    box-shadow: 0 16px 35px rgba(77, 56, 29, 0.16);
  }

  .sticker {
    min-height: 14rem;
    padding: var(--space-5);
    background: var(--paper, #fff8dd);
  }

  .sticker--green {
    --paper: #edf4df;
    grid-column: span 3;
    margin-top: var(--space-6);
    transform: rotate(-2.5deg);
  }

  .sticker--amber {
    --paper: #fff1c7;
    grid-column: span 3;
    transform: rotate(1.8deg);
  }

  .sticker--rose {
    --paper: #f8ddd4;
    grid-column: span 3;
    margin-top: var(--space-5);
    transform: rotate(2.4deg);
  }

  .sticker--guide {
    --paper: #fffaf1;
    grid-column: span 3;
    transform: rotate(-1deg);
  }

  .pin {
    position: absolute;
    top: 0.75rem;
    right: 0.9rem;
    width: 0.72rem;
    height: 0.72rem;
    border-radius: 50%;
    background: #b86b42;
    box-shadow:
      inset 0 1px 1px rgba(255, 255, 255, 0.4),
      0 2px 5px rgba(77, 56, 29, 0.28);
  }

  .pin-main {
    top: 1rem;
    left: 50%;
    right: auto;
    width: 0.86rem;
    height: 0.86rem;
    background: #9f4f43;
    transform: translateX(-50%);
  }

  .sticker small,
  .live-heading span {
    font-family: var(--font-mono);
  }

  .sticker small {
    color: var(--color-text-faint);
    font-size: 0.66rem;
    font-weight: 750;
    letter-spacing: 0.08em;
  }

  .sticker h2,
  .live-heading h2 {
    margin: var(--space-3) 0 0;
    font-family: var(--font-display);
    font-weight: 700;
  }

  .sticker h2 {
    font-size: clamp(1.45rem, 3vw, 1.9rem);
    line-height: 1.08;
  }

  .sticker p {
    margin: var(--space-4) 0 0;
    color: var(--color-text-soft);
    font-size: 0.86rem;
  }

  .sticker ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .sticker li {
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: var(--space-2);
    padding-block: var(--space-3);
    border-bottom: 1px dashed var(--color-border-strong);
  }

  .sticker li span {
    color: var(--color-accent-strong);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 750;
  }

  .sticker li p {
    margin: 0;
    color: var(--color-text-soft);
    font-size: 0.8rem;
  }

  .sticker > a {
    display: inline-block;
    margin-top: var(--space-5);
    color: var(--color-accent-strong);
    font-size: 0.78rem;
    font-weight: 750;
  }

  .live-sticker {
    grid-column: 1 / -1;
    padding: clamp(1.25rem, 4vw, 2.6rem);
    background:
      linear-gradient(115deg, rgba(255, 255, 255, 0.44), transparent 28%),
      repeating-linear-gradient(0deg, transparent 0 2.15rem, rgba(91, 70, 41, 0.045) 2.15rem 2.2rem),
      #fffdf6;
    box-shadow:
      0 22px 48px rgba(74, 54, 28, 0.18),
      inset 0 0 0 5px rgba(255, 255, 255, 0.4);
  }

  .live-heading {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: space-between;
    gap: var(--space-5);
    align-items: start;
    padding-bottom: var(--space-5);
    border-bottom: 1px solid rgba(91, 70, 41, 0.18);
  }

  .live-heading h2 {
    font-size: clamp(1.7rem, 4vw, 2.6rem);
    line-height: 1.05;
  }

  .live-heading > span {
    padding: 0.35rem 0.6rem;
    border: 1px solid var(--color-border-strong);
    border-radius: 0.45rem;
    color: var(--color-accent-strong);
    background: rgba(255, 248, 221, 0.72);
    font-size: 0.62rem;
    font-weight: 750;
  }

  .utterances-wrap {
    position: relative;
    z-index: 1;
    min-height: 15rem;
    margin-top: var(--space-5);
  }

  .utterances-wrap :global(.utterances) {
    max-width: none;
  }

  .comment-fallback {
    margin: var(--space-5) 0 0;
    padding-top: var(--space-4);
    border-top: 1px dashed var(--color-border-strong);
    color: var(--color-text-faint);
    font-size: 0.74rem;
    text-align: center;
  }

  .comment-fallback a {
    color: var(--color-accent-strong);
    font-weight: 750;
  }

  @media (max-width: 850px) {
    .comments-hero,
    .message-wall {
      grid-template-columns: 1fr;
    }

    .wall-preview {
      max-width: 26rem;
      transform: rotate(-0.8deg);
    }

    .sticker,
    .live-sticker {
      grid-column: 1;
      transform: none;
    }

    .sticker {
      min-height: auto;
    }
  }

  @media (max-width: 560px) {
    .message-wall {
      width: min(calc(100% - 0.6rem), var(--content-width));
      padding: 1rem;
      background-size: 30px 30px;
    }

    .comments-hero {
      padding-block: var(--space-7);
    }

    .live-heading {
      flex-direction: column;
      gap: var(--space-3);
    }

    .wall-preview {
      transform: none;
    }
  }
</style>
